generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole @default(EMPLOYEE)
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee?
  @@map("users")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String
  createdAt   DateTime @default(now())
  productName String

  managerId String
  manager   Employee @relation("TeamManager", fields: [managerId], references: [id], onDelete: Cascade)

  members Employee[] @relation("TeamMembers")
}

model JobRole {
  id        String     @id @default(uuid())
  name      String
  salary    Float
  employees Employee[]

  @@map("job_roles")
}

model Department {
  id        String     @id @default(uuid())
  name      String
  employees Employee[]
}

model Employee {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobRoleId     String   @map("role_id")
  jobRole       JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  joinDate      DateTime
  phone         String?
  address       String?

  attendance    Attendance[]
  tasks         Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  certifications Certification[]
  leaves         Leave[] @relation("EmployeeLeaves")
  approvedLeaves Leave[] @relation("LeaveApprovals")

  kpi            Float
  attendanceRate Float

  teamId String
  team   Team @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Cascade)

  managedTeams Team[] @relation("TeamManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model CompanyBranch {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float

  attendances Attendance[]
}

model Attendance {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  duration       Float?
  isWFH          Boolean  @default(false)

  companyBranchId String
  companyBranch   CompanyBranch @relation(fields: [companyBranchId], references: [id], onDelete: Cascade)

  isLate        Boolean @default(false)
  isHalfDay     Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, date])
  @@map("attendance")
}

model Tag {
  id    String @id @default(uuid())
  name  String
  tasks Task[]
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?

  status      TaskStatus  @default(TODO)
  priority    Priority    @default(MEDIUM)

  assigneeId  String?
  assignee    Employee?   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   Employee    @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  isApproved  Boolean     @default(false)

  tags        Tag[]

  dueDate     DateTime?
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tasks")
}

model Certification {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name       String
  issuer     String
  issueDate  DateTime
  expiryDate DateTime?
  url        String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("certifications")
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)

  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?

  status       LeaveStatus @default(PENDING)

  approvedById String?
  approvedBy   Employee? @relation("LeaveApprovals", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("leaves")
}

enum UserRole {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum TaskStatus {
  TODO
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  QA
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}